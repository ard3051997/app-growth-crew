# Values are literal: do not add shell quotes or spaces around '='.
APP_PACKAGE_NAME=com.example.app
GOOGLE_APPLICATION_CREDENTIALS=/tmp/mcp-gc-secrets/google-service-account.json

# Managed-beta API security. Generate independent high-entropy values. The
# proxy token must exactly match MCP_GC_PROXY_SHARED_TOKEN in proxy.env.
# Compose enforces MCP_GC_API_AUTH_REQUIRED=1 in managed mode.
MCP_GC_PROXY_SHARED_TOKEN=replace-with-the-same-random-token-as-proxy-env
# Optional direct API credentials for non-browser clients.
# MCP_GC_ADMIN_API_KEY=replace-with-an-independent-random-key
# MCP_GC_VIEWER_API_KEY=replace-with-an-independent-random-key
# Compose also forces MCP_GC_CONFIG_WRITES_ENABLED=0 and disables insecure
# development webhook bypasses; secret-file values cannot override those controls.

# RevenueCat sends this exact value in the configured header. Secure mode fails
# closed if the secret is absent. Provider event IDs are required and persisted.
MCP_GC_REVENUECAT_WEBHOOK_SECRET=replace-with-an-independent-random-secret
MCP_GC_REVENUECAT_WEBHOOK_HEADER=Authorization

# Add only integrations needed by the API. Keep app-specific secret fields null
# in apps.json so credentials remain in this mounted, untracked directory.
# GA4_PROPERTY_ID=000000000
# ADMOB_ACCOUNT_ID=pub-0000000000000000
# REVENUECAT_API_KEY=replace-me
# REVENUECAT_PROJECT_ID=replace-me
# GEMINI_API_KEY=replace-me
# Additional file credentials require an explicit Compose secret mount.
# GOOGLE_ADS_CONFIGURATION_FILE_PATH=/tmp/mcp-gc-secrets/google-ads.yaml
# GOOGLE_ADS_CUSTOMER_ID=000-000-0000
