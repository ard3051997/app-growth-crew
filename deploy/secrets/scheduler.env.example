# Use credentials restricted to read-only/viewer permissions. The scheduler can
# collect data, but must not be able to persist raw LLM proposals or change stores.
APP_PACKAGE_NAME=com.example.app
GOOGLE_APPLICATION_CREDENTIALS=/tmp/mcp-gc-secrets/google-service-account-read-only.json

